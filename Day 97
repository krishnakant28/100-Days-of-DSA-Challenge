#include <bits/stdc++.h>
using namespace std;

int minMeetingRooms(vector<pair<int,int>> &meetings) {
    if (meetings.empty()) return 0;

    // Step 1: Sort by start time
    sort(meetings.begin(), meetings.end());

    // Min heap for end times
    priority_queue<int, vector<int>, greater<int>> pq;

    // Add first meeting
    pq.push(meetings[0].second);

    for (int i = 1; i < meetings.size(); i++) {
        // If room is free
        if (meetings[i].first >= pq.top()) {
            pq.pop();
        }
        pq.push(meetings[i].second);
    }

    return pq.size();
}

int main() {
    vector<pair<int,int>> meetings = {{0,30}, {5,10}, {15,20}};
    cout << minMeetingRooms(meetings);
    return 0;
}
