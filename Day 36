#include <stdio.h>
#define MAX 100

int queue[MAX];
int front = -1, rear = -1;

// Enqueue operation
void enqueue(int value) {
    if ((rear + 1) % MAX == front) {
        // Queue is full
        return;
    }
    if (front == -1) {
        front = 0;
    }
    rear = (rear + 1) % MAX;
    queue[rear] = value;
}

// Dequeue operation
void dequeue() {
    if (front == -1) {
        // Queue is empty
        return;
    }
    if (front == rear) {
        // Only one element
        front = rear = -1;
    } else {
        front = (front + 1) % MAX;
    }
}

// Display queue
void display() {
    if (front == -1) return;

    int i = front;
    while (1) {
        printf("%d ", queue[i]);
        if (i == rear) break;
        i = (i + 1) % MAX;
    }
}

int main() {
    int n, m, i, x;

    // Input number of elements
    scanf("%d", &n);

    // Enqueue elements
    for (i = 0; i < n; i++) {
        scanf("%d", &x);
        enqueue(x);
    }

    // Number of dequeue operations
    scanf("%d", &m);

    // Perform dequeue
    for (i = 0; i < m; i++) {
        dequeue();
    }

    // Display final queue
    display();

    return 0;
}
