class Node:
    def __init__(self, data):
        self.data = data
        self.next = None

# Create linked list
def create_linked_list(arr):
    head = Node(arr[0])
    temp = head
    
    for i in range(1, len(arr)):
        new_node = Node(arr[i])
        temp.next = new_node
        temp = new_node
        
    return head

# Traverse and print
def traverse(head):
    temp = head
    while temp:
        print(temp.data, end=" ")
        temp = temp.next

# Input
n = int(input())
arr = list(map(int, input().split()))

# Create list
head = create_linked_list(arr)

# Traverse list
traverse(head)
