# Linear Search with comparison count

# Input
n = int(input())
arr = list(map(int, input().split()))
k = int(input())

comparisons = 0
found = False

for i in range(n):
    comparisons += 1
    if arr[i] == k:
        print(f"Found at index {i}")
        found = True
        break

if not found:
    print("Not Found")

print(f"Comparisons = {comparisons}")
