from collections import deque

class Node:
    def __init__(self, val):
        self.data = val
        self.left = None
        self.right = None

def buildTree(arr):
    if not arr or arr[0] == -1:
        return None

    root = Node(arr[0])
    q = deque([root])
    i = 1

    while q and i < len(arr):
        current = q.popleft()

        # Left child
        if arr[i] != -1:
            current.left = Node(arr[i])
            q.append(current.left)
        i += 1

        if i >= len(arr):
            break

        # Right child
        if arr[i] != -1:
            current.right = Node(arr[i])
            q.append(current.right)
        i += 1

    return root

def inorder(root):
    if root:
        inorder(root.left)
        print(root.data, end=" ")
        inorder(root.right)

# Input
n = int(input())
arr = list(map(int, input().split()))

# Build tree and print inorder
root = buildTree(arr)
inorder(root)
