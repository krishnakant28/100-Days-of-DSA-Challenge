def firstNonRepeating(s):
    freq = {}

    # Step 1: Count frequencies
    for ch in s:
        freq[ch] = freq.get(ch, 0) + 1

    # Step 2: Find first non-repeating character
    for ch in s:
        if freq[ch] == 1:
            return ch

    # Step 3: If none found
    return '$'


# Example usage
s = input().strip()
print(firstNonRepeating(s))
