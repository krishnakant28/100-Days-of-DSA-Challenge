#include <iostream>
using namespace std;

int main() {
    int m, n;
    cin >> m >> n;

    int matrix[m][n];

    // Input matrix
    for(int i = 0; i < m; i++) {
        for(int j = 0; j < n; j++) {
            cin >> matrix[i][j];
        }
    }

    int sum = 0;
    int limit = min(m, n);

    // Calculate primary diagonal sum
    for(int i = 0; i < limit; i++) {
        sum += matrix[i][i];
    }

    cout << sum;

    return 0;
}
