#include <iostream>
using namespace std;

int main() {
    int m, n;
    cin >> m >> n;

    int matrix[100][100];

    // Input matrix
    for(int i = 0; i < m; i++) {
        for(int j = 0; j < n; j++) {
            cin >> matrix[i][j];
        }
    }

    // Check if matrix is square
    if(m != n) {
        cout << "Not a Symmetric Matrix";
        return 0;
    }

    // Check symmetry
    for(int i = 0; i < m; i++) {
        for(int j = 0; j < n; j++) {
            if(matrix[i][j] != matrix[j][i]) {
                cout << "Not a Symmetric Matrix";
                return 0;
            }
        }
    }

    cout << "Symmetric Matrix";

    return 0;
}
