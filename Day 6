#include <iostream>
using namespace std;

int main() {
    int n;
    cin >> n;

    int arr[n];
    for(int i = 0; i < n; i++) {
        cin >> arr[i];
    }

    if(n == 0) return 0;

    int i = 0;  // Pointer for unique elements

    for(int j = 1; j < n; j++) {
        if(arr[j] != arr[i]) {
            i++;
            arr[i] = arr[j];
        }
    }

    // Print unique elements
    for(int k = 0; k <= i; k++) {
        cout << arr[k] << " ";
    }

    return 0;
}
